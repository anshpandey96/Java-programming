package challenge100;

public class PrintThread extends Thread {
    private final int threadNumber;  // Declare field at class level

    public PrintThread(int threadNumber) {
        this.threadNumber = threadNumber;  // Assign inside constructor
    }

    @Override
    public void run() {
        System.out.printf("%s Thread Starting - %d%n",
                Thread.currentThread().getName(),
                threadNumber);

        try {
            Thread.sleep(5000);
        } catch (InterruptedException e) {
            throw new RuntimeException(e);
        }

        System.out.printf("%s Thread Ended - %d%n",
                Thread.currentThread().getName(),
                threadNumber);
    }
}
