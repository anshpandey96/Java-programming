public class StringFormat {

    public static void main(String[] args) {

        String name = "ansh";
        int marks = 45;
        System.out.println("Hello " + name + " Your marks are : "  + marks );
        System.out.printf(" Hello %s, your marks are : %d ",  name , marks );
        System.out.printf( "\n Hello %S, your marks are : %d ",  name , marks );
        System.out.printf(" \n Hello %10S, your marks are : %d " ,  name , marks );
        System.out.printf("\n Hello %-10S, your marks are : %d ",  name , marks );

    }
}
