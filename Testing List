package collection;

import java.util.ArrayList;
import java.util.List;

public class TestingList {
    public static void main(String[] args) {

        List<String> strList = new ArrayList<>(); //use only string type
        strList.add("Ansh");
        strList.add("Pandey");
        // strList.add(54);  //we can not give integer value

        strList.add(1, "kumar");

       strList.remove(1);  //use for removiong element

       if( strList.contains("Pandey")){   //for use contain

           System.out.println("Ansh exists");
           System.out.println(strList.indexOf("Ansh"));
       }

        for( int i= 0; i< strList.size(); i++){
            System.out.println(strList.get(i));
        }

         for (String str : strList) {
             System.out.println(str);

         }

    }
}
