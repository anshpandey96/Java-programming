package challenge98;

public class HelloThread extends Thread {
    private final int threadNumber;

    public HelloThread(int threadNumber) {
        this.threadNumber = threadNumber;
    }

    @Override
    public void run() {
        for (int i = 0; i < 10; i++) {
            // Option 1: using printf
            System.out.printf("(%d) %s Hello from Thread %d\n",
                    i++, Thread.currentThread().getName(),
                    threadNumber);

            // Option 2: using concatenation
            // System.out.println("Hello from Thread " + threadNumber);
        }
    }

    public static void main(String[] args) {
        // Example: start 3 threads
        for (int i = 1; i <= 3; i++) {
            new HelloThread(i).start();
        }
    }
}
